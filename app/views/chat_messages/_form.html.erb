<%= form_with model: ChatMessage.new,
      url: chat_messages_path,
      data: { turbo_frame: "_top", controller: "chat-form", action: "turbo:submit-end->chat-form#reset" },
      class: "flex gap-2 items-end p-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))] bg-[#F0F0F0] border-t border-gray-200" do |form| %>
  <%= form.text_field :content,
        placeholder: "Tulis transaksi... (misal: beli kopi 25rb)",
        autofocus: true,
        autocomplete: "off",
        required: true,
        data: { chat_form_target: "input" },
        class: "flex-1 rounded-full border border-gray-300 bg-white px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#075E54] focus:border-transparent" %>
  <%= form.submit "Kirim",
        class: "rounded-full bg-[#075E54] text-white px-4 py-2 text-sm font-semibold hover:bg-[#064a43] active:scale-95 cursor-pointer disabled:opacity-50" %>
<% end %>
