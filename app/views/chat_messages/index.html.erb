<% content_for :title, "Chat" %>

<%= turbo_stream_from Current.user %>

<section class="flex flex-col h-[calc(100dvh-3.5rem)]" data-controller="autoscroll">
  <div id="messages"
       class="flex-1 overflow-y-auto py-2 bg-[#ECE5DD]"
       data-autoscroll-target="stream">
    <% if @chat_messages.empty? %>
      <div class="flex items-center justify-center h-full text-sm text-gray-500 px-6 text-center">
        Kirim pesan pertamamu, misalnya "abis beli kopi 25rb".
      </div>
    <% end %>
    <% @chat_messages.each do |chat_message| %>
      <%= render "chat_messages/message", chat_message: chat_message %>
      <% case chat_message.parser_status %>
      <% when "logged" %>
        <%= render "chat_messages/confirmation", chat_message: chat_message %>
      <% when "not_transaction" %>
        <%= render "chat_messages/reply", chat_message: chat_message %>
      <% when "failed" %>
        <%= render "chat_messages/error", chat_message: chat_message %>
      <% when "pending" %>
        <%= render "chat_messages/thinking", chat_message: chat_message %>
      <% end %>
    <% end %>
  </div>

  <div id="chat_form">
    <%= render "chat_messages/form" %>
  </div>
</section>
